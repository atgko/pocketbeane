# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Yahoo OAuth — get from developer.yahoo.com/apps
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here
# Local: http://localhost:3000/api/auth/yahoo/callback
# Production: https://your-vercel-domain.vercel.app/api/auth/yahoo/callback
YAHOO_REDIRECT_URI=http://localhost:3000/api/auth/yahoo/callback

# AES-256 key for encrypting Yahoo tokens in the session cookie.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# Resend — get from resend.com/api-keys
RESEND_API_KEY=your_resend_key_here
# Must be a verified sender on your Resend account/domain. Defaults to
# Resend's shared sandbox address if unset (only delivers to your own
# Resend account email until a domain is verified).
RESEND_FROM_EMAIL=PocketBeane <onboarding@resend.dev>
