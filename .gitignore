# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/

# env files — never commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# script source data — re-downloaded each season before draft
scripts/data/

# script review artifact
scripts/review.json

# local tool config
.claude/

# impeccable: per-machine state, not shared project config
.impeccable/config.local.json
.impeccable/hook.cache.json

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
.env*.local

# Python cache
__pycache__/
*.pyc

# weekly pipeline run-once-per-day guard (local machine state, not data)
data-updates/.last_run

# weekly pipeline run logs (local machine diagnostics, not project data)
scripts/logs/
